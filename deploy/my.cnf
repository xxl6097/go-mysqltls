# mysqltls-demo —— MySQL 服务端 TLS 配置
#
# docker-compose.yml 把这文件只读挂载到 /etc/mysql/conf.d/tls.cnf,
# 官方 mysql:8.0 镜像的 /etc/mysql/my.cnf 用 !includedir 自动加载 conf.d/*.cnf。
# 改这里之后不用改 compose, 只需: docker compose restart mysql
#
# 注意: 路径是「容器内部」路径; certs/ 目录以只读方式挂载在 /certs。
[mysqld]
# --- TLS 证书/私钥 (对应 ./scripts/gen-ca.sh 的产物) ---
ssl_ca   = /certs/ca.pem
ssl_cert = /certs/server.pem
ssl_key  = /certs/server.key

# 全局强制加密: 任何非 TLS 连接直接拒绝
require_secure_transport = ON

# 与 demo DSN 的 charset=utf8mb4 对齐
character-set-server = utf8mb4
collation-server     = utf8mb4_unicode_ci
