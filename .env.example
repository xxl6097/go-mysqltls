# 模式: tls | pin | ssh
MODE=tls

# 通用 MySQL 配置
MYSQL_HOST=mysql.example.com
MYSQL_PORT=3306
MYSQL_USER=appuser
MYSQL_PASSWORD=changeme
MYSQL_DB=shop

# 方案二 (TLS + CA) 默认用 go:embed 内嵌的 certs/ca.pem, 不需要此变量。
# 仅当要临时覆盖 CA (例如轮换期新旧 CA 并存) 时才设置, 指向外部 PEM 文件:
# MYSQL_CA_PATH=/absolute/path/to/certs/ca.pem

# 方案四 还要 SPKI 指纹 (base64). 生成方式:
#   openssl x509 -in certs/server.pem -pubkey -noout | \
#     openssl pkey -pubin -outform DER | \
#     openssl dgst -sha256 -binary | base64
MYSQL_SPKI_FP=

# 方案三 (SSH 隧道) 额外需要
MYSQL_SSH_HOST=jump.example.com:22
MYSQL_SSH_USER=deploy
MYSQL_SSH_KEY_PATH=/absolute/path/to/jump_key
# 可选: 自定义 known_hosts, 默认 $HOME/.ssh/known_hosts
# MYSQL_SSH_KNOWN_HOSTS=/etc/ssh/known_hosts
